generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Flashcard{
  id Int @id @default(autoincrement())
  word String
  description String?
  translations TranslationsOnFlashcards[]
  createdAt DateTime @map("created_at") @default(now())
  updatedAt DateTime @map("updated_at") @updatedAt
  @@map("flashcards")
}

model Translation{
  id Int @id @default(autoincrement())
  language String
  word String
  flashcards TranslationsOnFlashcards[]
  createdAt DateTime @map("created_at") @default(now())
  updatedAt DateTime @map("updated_at") @updatedAt
  @@map("translations")
}

model TranslationsOnFlashcards{
  flashcard Flashcard @relation(fields: [flashcardId], references: [id])  
  flashcardId Int
  translation Translation @relation(fields: [translationId], references: [id])
  translationId Int
  @@map("translations_on_flashcards")
  @@id([flashcardId, translationId])
}